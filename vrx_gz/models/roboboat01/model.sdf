<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="waves_visual">
    <static>true</static>

    <link name="link">
      <visual name="ocean">
        <geometry>
          <mesh>
            <uri>model://waves_visual/meshes/mesh_L256m_N256.dae</uri>
          </mesh>
        </geometry>

        <material>
          <shader type="vertex">
            <uri>model://waves_visual/materials/waves_vs.metal</uri>
          </shader>
          <shader type="fragment">
            <uri>model://waves_visual/materials/waves_fs.metal</uri>
          </shader>
        </material>

        <cast_shadows>false</cast_shadows>
      </visual>
    </link>
  </model>
</sdf>
